# Godot
project/.godot/
exports/
*.tmp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.superpowers/

# Voice reference recordings (source audio, not shipped)
art/voice_refs/*.wav

# local runtime logs and exports (never commit)
.claude/logs/
.beads/interactions.jsonl
.beads/issues.jsonl
tools/deploy_web.env
# tools/web_render: unidentified captures (may be a sign-in/error page) and ffmpeg temp inputs
prompts/**/*.unknown
prompts/**/*.src.*
# promo site: build output written by tools/deploy_site.sh (names a build; not committed)
site/public/play/*/
site/public/play/index.html
site/public/_redirects
site/.wrangler/
site/node_modules/

# Build id written by tools/deploy_site.sh before each export (shown on the main menu)
project/build.json

# Playwright MCP screenshots and logs
.playwright-mcp/
