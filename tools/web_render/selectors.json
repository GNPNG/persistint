{
  "_readme": "Every URL, selector and click order the web renderer uses. Edit this file (not the code) when Google changes its pages. Each selector list is tried in order until one matches a visible element. Selector syntax is Puppeteer's: plain CSS, ::-p-aria(Accessible name), ::-p-text(Visible text), ::-p-xpath(...). steps.result must be plain CSS. {aspect} is replaced with the asset's ratio. Validate with: node render.mjs --check-selectors. NONE of the Google selectors below have been tested against the live signed-in pages yet; they come from Google's help pages and community scripts.",
  "loginUrl": "https://accounts.google.com/",
  "outcomeText": {
    "_readme": "Used by tracker mode (lib/tracker.mjs) to classify a reply that finished without media. Lower-case substrings of the reply text. quota: also every ::-p-text(...) in steps.limitNotice. refused: the asset is parked as 'Needs prompt edit' (no retry). A reply with no media that matches neither is 'failed' and retried.",
    "quota": [
      "usage limit",
      "reached your limit",
      "limit resets",
      "out of generations",
      "come back tomorrow"
    ],
    "refused": [
      "can't generate",
      "can't create",
      "cannot generate",
      "cannot create",
      "unable to generate",
      "unable to create",
      "not able to generate",
      "not able to create",
      "can't help with",
      "policy",
      "policies",
      "guidelines",
      "violate",
      "blocked",
      "not allowed"
    ]
  },
  "kinds": {
    "image": "gemini_image",
    "video": "gemini_video",
    "music": "gemini_music"
  },
  "surfaces": {
    "gemini_image": {
      "kind": "image",
      "url": "https://gemini.google.com/app",
      "_note": "Gemini app, Tools > Create images (Nano Banana). No aspect control in the UI, so the ratio is put in the prompt when the prompt does not already state one.",
      "aspectInPrompt": true,
      "promptSuffix": "{aspect} aspect ratio.",
      "promptPrefix": "@persistint-asset-prompts Create an image:",
      "_promptPrefix": "Author 2026-10-24: include '@persistint-asset-prompts' (the author's Gemini skill) in every render prompt for this project.",
      "resultMinSize": 256,
      "capture": [
        "download"
      ],
      "_capture": "download only: the on-page <img> (a blob: URL) is a downscaled preview, so it must never be saved as the final PNG. The finished result (seen 2026-10-24) is model-response > generated-image > single-image > img.image[src^=blob:] with hover controls Share image / Copy image / <download-generated-image-button data-test-id=download-generated-image-button> button[aria-label='Download full size image']. That click makes the app request the full-size file from Google (a batchexecute RPC) and then save it as a browser download; if Google redirects that request to its check page (www.google.com/sorry) no download ever starts, which the engine now reports at once as 'blocked'. If Download full size breaks otherwise, fix its selector or use --assist / --pause-on-error.",
      "timeouts": {
        "stepMs": 20000,
        "generateMs": 600000,
        "downloadMs": 180000,
        "textOnlyMs": 90000
      },
      "steps": {
        "open": [
          {
            "action": "click",
            "optional": true,
            "timeoutMs": 3000,
            "note": "close a promo dialog if one is up",
            "selectors": [
              "::-p-aria(Close)",
              "::-p-aria(Dismiss)",
              "::-p-aria(No thanks)"
            ]
          }
        ],
        "mode": [
          {
            "action": "click",
            "note": "open the Upload & tools (+) menu",
            "afterMs": 800,
            "selectors": [
              "input-area-v2 ::-p-aria(Upload & tools)",
              "::-p-aria(Upload & tools)",
              "button[data-test-id='toolbox-trigger']",
              "::-p-aria(Tools)"
            ]
          },
          {
            "action": "click",
            "note": "pick the image tool if the menu has one, else close the menu (the prompt prefix asks for an image)",
            "afterMs": 800,
            "timeoutMs": 5000,
            "orPress": "Escape",
            "selectors": [
              ".cdk-overlay-container ::-p-text(Create image)",
              ".cdk-overlay-container ::-p-aria(Create images)",
              ".cdk-overlay-container ::-p-text(Images)",
              ".cdk-overlay-container ::-p-aria(Images)"
            ]
          }
        ],
        "options": [],
        "input": [
          "rich-textarea .ql-editor[contenteditable='true']",
          "::-p-aria(Enter a prompt for Gemini)",
          ".ql-editor[contenteditable='true']",
          "div[contenteditable='true'][role='textbox']",
          "textarea:not([placeholder='Ask Gemini'])"
        ],
        "blocked": [
          "iframe[title='reCAPTCHA']",
          "::-p-text(unusual traffic)",
          "::-p-text(Why did this happen?)"
        ],
        "submit": [
          {
            "action": "click",
            "note": "send (Enter if the send button is not found)",
            "orPress": "Enter",
            "selectors": [
              "::-p-aria(Send message)",
              "button.send-button",
              "button[aria-label*='Send']",
              "::-p-aria(Submit)"
            ]
          }
        ],
        "busy": [
          "::-p-aria(Stop response)",
          "button[aria-label*='Stop']"
        ],
        "limitNotice": [
          "model-response ::-p-text(reached your limit)",
          "model-response ::-p-text(reached the limit)",
          "model-response ::-p-text(usage limit)",
          "model-response ::-p-text(limit resets)"
        ],
        "response": [
          "model-response"
        ],
        "result": [
          "model-response generated-image single-image img.image",
          "model-response generated-image img",
          "model-response single-image img",
          "model-response img",
          "message-content img"
        ],
        "download": [
          {
            "action": "hover",
            "target": "result",
            "afterMs": 500
          },
          {
            "action": "click",
            "note": "Download full size",
            "selectors": [
              "model-response download-generated-image-button button[aria-label='Download full size image']",
              "model-response [data-test-id='download-generated-image-button'] button",
              "model-response ::-p-aria(Download full size image)",
              "model-response ::-p-aria(Download full size)",
              "model-response button:has(mat-icon[fonticon='download'])",
              "::-p-aria(Download full size image)"
            ]
          }
        ]
      }
    },
