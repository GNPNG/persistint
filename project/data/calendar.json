{
	"cohort_signals": [
		{ "id": "gate_opens", "cohort": "first", "when": { "cycle_day_min": 1, "cycle_day_max": 3 },
		  "text": "The first cohort's Gate has opened. By the Covenant's count, a new cycle begins today." },
		{ "id": "womb_calls", "cohort": "all", "when": { "cycle_day_min": 4, "cycle_day_max": 6 },
		  "text": "The cohorts are aligned. The womb calls. The rites are held, and the drones are brought in." },
		{ "id": "training_days", "cohort": "second", "when": { "cycle_day_min": 7, "cycle_day_max": 11 },
		  "text": "Second cohort chants for the initiates. Training days: texts, blood-art, memorization." },
		{ "id": "fourteenth_eve", "cohort": "all", "when": { "days_until_festival": 1 },
