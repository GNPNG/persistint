; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Persistint"
config/version="0.2.1"
run/main_scene="res://scenes/ui/studio_intro.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.992157, 0.964706, 0.890196, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=true
boot_splash/image="res://assets/ui/brand/boot_splash.png"
config/icon="res://assets/ui/icon/app_icon.png"

[audio]

general/text_to_speech=false

[autoload]

WorldState="*res://scripts/autoload/world_state.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Voice="*res://scripts/autoload/voice.gd"
Music="*res://scripts/autoload/music.gd"
AudioSettings="*res://scripts/autoload/audio_settings.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
Cast="*res://scripts/autoload/cast.gd"
NameIt="*res://scripts/autoload/name_it.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
DevScene="*res://scripts/autoload/dev_scene.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/dialogue_balloon.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom="res://themes/default.tres"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/priestess.dialogue", "res://dialogue/offering.dialogue", "res://dialogue/interview.dialogue", "res://dialogue/florida_beach.dialogue", "res://dialogue/florida_stable.dialogue", "res://dialogue/next_top_comic.dialogue")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
