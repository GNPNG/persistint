extends Node
## Voice — speech for every spoken line (author, 2026-10-23: "speech ... with LLM-based
## impersonated narration"; beads persistint-game-zkk).
## 1. If an impersonated voice clip exists for the line — res://audio/voice/<key>.wav,
##    generated by tools/generate_voice_clips.py from tools/export_voice_lines.mjs's manifest — it plays.
## 2. Otherwise the line is spoken with the platform's text-to-speech (desktop OS voices;
##    the browser's speech synthesis in the HTML5 build), one voice per speaker.
## Dialogue Manager lines are spoken automatically as they appear.
## Vocalizations (author 2026-10-24: text-to-speech "doesn't do a good job of the groaning
## effects"): a sound written in square brackets, "[Uuunnngh.] Shamble.", is never read aloud.
## It plays as a generated vocalization from audio/sfx (tools/gen_clone_sfx.py: groan_1-3, moan,
## growl, picked by the sound's spelling) and the words follow, in order. Bubbles show the
## sound without its brackets (display_text); clips are keyed on the words alone (spoken_text).
## A line can be played through another audio bus: the clone children use "Clones", a plain
## volume bus; their kid voice is baked offline into audio/voice/clones/ copies of the clips and
## vocalizations (tools/bake_clone_voices.py), which play when the line goes through that bus.
## Nothing is processed in real time and nothing is read by text-to-speech: a line with no clip
## shows its bubble and stays silent.
## While a clip or vocalization of the cast plays, Music ducks the loop (Music.duck_voice, a volume
## move, no audio effect) so speech sits above it.
## Two kinds of player (the author, 2026-10-27, on the clone hall: one zombie noise "starts playing
## and the other one stops playing"):
## - speak(): the cast's one channel, a plain AudioStreamPlayer; a new line replaces the one before
##   it (dialogue lines follow each other), and only these lines duck the music.
## - speak_at(): a line from a node in the world (the clone children, the polar bear cubs) on that
##   node's own AudioStreamPlayer2D (VOICE_AT, made on first use): lines from different nodes
##   overlap and fade with distance, never cut each other or the cast's line off, and never duck
##   the music. A node mid-line doesn't start another; a caller can cap how many play at once.

## Every line handed to speak() or speak_at(), clip or not (tests listen to it): the text as a
## bubble shows it, brackets removed.
signal spoke(speaker: String, text: String)

## The name of the positional player speak_at() gives a node.
const VOICE_AT := "VoiceAt"

const CLIP_DIR := "res://audio/voice"
const SFX_DIR := "res://audio/sfx"
const GROANS := ["groan_1", "groan_2", "groan_3"]

static var _bracket := RegEx.create_from_string("\\[([^\\]]*)\\]")
static var _spaces := RegEx.create_from_string("\\s+")
static var _letters := RegEx.create_from_string("[^a-z]")

var _player: AudioStreamPlayer
var _queue: Array = []  # what is left to play of the current line: {"sfx": path} | {"say": text}
var _speaker := ""
## Positional players mid-line (speak_at): player -> {"queue": parts left, "speaker": String}.
var _at := {}


func _ready() -> void:
	_player = AudioStreamPlayer.new()
	_player.bus = "Voice"
	_player.finished.connect(_play_next)
	add_child(_player)
	var dm := get_node_or_null("/root/DialogueManager")
	if dm and dm.has_signal("got_dialogue"):
		dm.got_dialogue.connect(func(line) -> void: speak(line.text, 1.0, line.character))


## Text-to-speech is never used (the author: no robot voices); kept so old callers compile.
static func tts_available() -> bool:
	return false


const CLONES_DIR := "res://audio/voice/clones"

## Author 2026-10-25: the pitch-shifted (baked kid-clone) copies are off for now, so the raw cloned
## clips can be judged on their own; set true again to restore the clone-hall voices (kz2).
static var pitched_clones := false


## The baked kid-clone copy of a clip or vocalization when the line plays through the Clones bus.
static func clone_variant(path: String, bus: String) -> String:
	if bus != "Clones" or not pitched_clones:
		return path
	var baked := "%s/%s" % [CLONES_DIR, path.get_file()]
	return baked if ResourceLoader.exists(baked) else path


## The line as a bubble shows it: the brackets gone, the sounds kept ("Uuunnngh. Shamble.").
static func display_text(text: String) -> String:
	return _tidy(text.replace("[", "").replace("]", ""))


## The words of the line alone, every bracketed sound removed ("Shamble.").
static func spoken_text(text: String) -> String:
	return _tidy(_bracket.sub(text, " ", true))


## The bracketed sounds of the line, brackets kept, joined by spaces ("[Uuunnngh.] [Mrrh.]").
static func brackets_of(text: String) -> String:
	var out := PackedStringArray()
	for m: RegExMatch in _bracket.search_all(text):
		out.append("[%s]" % m.get_string(1).strip_edges())
	return " ".join(out)


## The line in playing order: {"sfx": vocalization name} and {"say": words} parts.
static func parts(text: String) -> Array:
	var out: Array = []
	var pos := 0
	for m: RegExMatch in _bracket.search_all(text):
		var words := _tidy(text.substr(pos, m.get_start() - pos))
		if words != "":
			out.append({"say": words})
		var sound := m.get_string(1).strip_edges()
		if sound != "":
			out.append({"sfx": sfx_for(sound)})
		pos = m.get_end()
	var rest := _tidy(text.substr(pos))
	if rest != "":
		out.append({"say": rest})
	return out


## The generated vocalization (audio/sfx/<name>.wav) for a bracketed sound, by its spelling:
## g... a growl, m... a moan with the mouth shut, anything else one of the groans (always the
## same one for the same spelling).
static func sfx_for(sound: String) -> String:
	var v := _letters.sub(sound.to_lower(), "", true)
	if v.begins_with("g"):
		return "growl"
	if v.begins_with("m"):
		return "moan"
	return GROANS[absi(hash(v)) % GROANS.size()]


static func sfx_path(sound: String) -> String:
	return "%s/%s.wav" % [SFX_DIR, sfx_for(sound)]


static func _tidy(s: String) -> String:
	return _spaces.sub(s, " ", true).strip_edges()


## Stable key for a spoken line (its words; bracketed sounds don't count); the clip generator
## names files with it.
static func line_key(speaker: String, text: String) -> String:
	return ("%s|%s" % [speaker, spoken_text(text)]).md5_text()


static func clip_path(speaker: String, text: String) -> String:
	return "%s/%s.wav" % [CLIP_DIR, line_key(speaker, text)]


## Speaks `text` as `speaker`: its bracketed sounds as vocalizations, its words as the
## clip, in order, through audio bus `bus`. `pitch` is kept for callers; nothing uses it now.
func speak(text: String, pitch := 1.0, speaker := "", bus := "Voice") -> void:
	var shown := display_text(text)
	if shown.is_empty():
		return
	spoke.emit(speaker, shown)
	_speaker = speaker
	_player.bus = bus if AudioServer.get_bus_index(bus) >= 0 else "Voice"
	_player.stop()
	_queue = parts(text)
	_play_next()


## Speaks `text` as `speaker` from `source`'s own positional player (VOICE_AT, an
## AudioStreamPlayer2D made on first use on bus `bus`): its bracketed sounds, then its words, in
## order, like speak(). Lines from different nodes overlap; none is cut off by another, by the
## cast's speak(), or by this one. Returns true when the line starts playing; false (the line
## silent, `spoke` still fires so the bubble can show it) when `source` is still mid-line, when
## `max_voices` > 0 and that many positional lines already play, or when it has nothing to play.
func speak_at(source: Node2D, text: String, speaker := "", bus := "Clones", max_voices := 0) -> bool:
	var shown := display_text(text)
	if shown.is_empty() or source == null or not source.is_inside_tree():
		return false
	spoke.emit(speaker, shown)
	var p := player_at(source, bus)
	if speaking_at(source) or (max_voices > 0 and voices_at() >= max_voices):
		return false
	_at[p] = {"queue": parts(text), "speaker": speaker}
	_next_at(p)
	return _at.has(p)


## `source`'s positional player, made on first use: an AudioStreamPlayer2D child named VOICE_AT
## on `bus` (Clones when there is no such bus), one sound at a time. Its distance falloff
## (max_distance, attenuation) is the caller's to set; plain player properties, no audio effect.
func player_at(source: Node2D, bus := "Clones") -> AudioStreamPlayer2D:
	var p := source.get_node_or_null(VOICE_AT) as AudioStreamPlayer2D
	if p == null:
		p = AudioStreamPlayer2D.new()
		p.name = VOICE_AT
		p.max_polyphony = 1
		p.max_distance = 720.0
		p.attenuation = 1.5
		p.finished.connect(_next_at.bind(p))
		p.tree_exiting.connect(func() -> void: _at.erase(p))
		source.add_child(p)
	p.bus = bus if AudioServer.get_bus_index(bus) >= 0 else "Clones"
	return p


## True while `source` is mid-line through speak_at().
func speaking_at(source: Node) -> bool:
	var p := source.get_node_or_null(VOICE_AT) if source else null
	return p != null and _at.has(p)


## How many positional lines (speak_at) are playing now.
func voices_at() -> int:
	for p: Variant in _at.keys():
		if not is_instance_valid(p):
			_at.erase(p)
	return _at.size()


func _next_at(p: AudioStreamPlayer2D) -> void:
	if not _at.has(p):
		return
	if not is_instance_valid(p) or not _start_next(p, _at[p]["queue"], _at[p]["speaker"]):
		_at.erase(p)


func _duck(on: bool) -> void:
	var music := get_node_or_null("/root/Music")
	if music and music.has_method("duck_voice"):
		music.duck_voice(on)


## What is still to play of the cast's current line (sounds and words), in order.
func pending() -> Array:
	return _queue.duplicate()


func _play_next() -> void:
	_duck(_start_next(_player, _queue, _speaker))


## Starts the next playable part of a line on `player` (a vocalization, or the words' clip; a part
## with no file is skipped: the bubble shows it). Returns false when nothing is left to play.
## The player's `finished` calls back for the part after.
func _start_next(player: Node, queue: Array, speaker: String) -> bool:
	while not queue.is_empty():
		var part: Dictionary = queue.pop_front()
		var path: String = "%s/%s.wav" % [SFX_DIR, part["sfx"]] if part.has("sfx") else clip_path(speaker, part["say"])
		path = clone_variant(path, String(player.bus))
		if ResourceLoader.exists(path):
			player.stream = load(path)
			player.play()
			return true
	return false
