extends Node
## Voice — speech for every spoken line (author, 2026-10-23: "speech ... with LLM-based
## impersonated narration"; beads persistint-game-zkk).
## 1. If an impersonated voice clip exists for the line — res://audio/voice/<key>.wav,
##    generated by tools/generate_voice_clips.py from tools/export_voice_lines.py's manifest — it plays.
## 2. Otherwise the line is spoken with the platform's text-to-speech (desktop OS voices;
##    the browser's speech synthesis in the HTML5 build), one voice per speaker.
## Dialogue Manager lines are spoken automatically as they appear.

const CLIP_DIR := "res://audio/voice"

var _player: AudioStreamPlayer
var _voices: Array = []
var _speaker_voice: Dictionary = {}  # speaker -> voice id


func _ready() -> void:
	_player = AudioStreamPlayer.new()
	_player.bus = "Master"
	add_child(_player)
	if tts_available():
		_voices = DisplayServer.tts_get_voices_for_language("en")
	var dm := get_node_or_null("/root/DialogueManager")
	if dm and dm.has_signal("got_dialogue"):
		dm.got_dialogue.connect(func(line) -> void: speak(line.text, 1.0, line.character))


static func tts_available() -> bool:
	return ProjectSettings.get_setting("audio/general/text_to_speech", false) \
		and DisplayServer.get_name() != "headless"


## Stable key for a spoken line; the clip generator names files with it.
static func line_key(speaker: String, text: String) -> String:
	return ("%s|%s" % [speaker, text]).md5_text()


static func clip_path(speaker: String, text: String) -> String:
	return "%s/%s.wav" % [CLIP_DIR, line_key(speaker, text)]


func speak(text: String, pitch := 1.0, speaker := "") -> void:
	if text.strip_edges().is_empty():
		return
	var clip := clip_path(speaker, text)
	if ResourceLoader.exists(clip):
		_player.stream = load(clip)
		_player.play()
		return
	if not tts_available():
		return
	DisplayServer.tts_stop()
	DisplayServer.tts_speak(text, _voice_for(speaker), 50, clampf(pitch, 0.5, 2.0))


func _voice_for(speaker: String) -> String:
	# Browsers load speech-synthesis voices asynchronously, so the list read in _ready() is
	# often empty in the HTML5 build; ask again until voices arrive.
	if _voices.is_empty():
		_voices = DisplayServer.tts_get_voices_for_language("en")
	if _voices.is_empty():
		_voices = Array(DisplayServer.tts_get_voices()).map(func(v: Dictionary) -> String: return v["id"])
	if _voices.is_empty():
		return ""
	if not _speaker_voice.has(speaker):
		_speaker_voice[speaker] = _voices[_speaker_voice.size() % _voices.size()]
	return _speaker_voice[speaker]
